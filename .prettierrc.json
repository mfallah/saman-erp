{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md", "*.yml", "*.yaml"], "options": { "printWidth": 120, "proseWrap": "preserve" } }
  ]
}
