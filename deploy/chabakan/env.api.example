# =============================================================================
# Saman ERP — Chabakan / Docker service: API role
# Copy these into: سرویس ← تنظیمات ← متغیرهای محیطی  (or upload this file)
# Never commit real secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production
NODE_ENV=production
APP_NAME=Saman ERP
APP_PORT=3000
APP_URL=https://erp.carexy.shop
API_PREFIX=api
API_VERSION=v1
APP_TIMEZONE=Asia/Tehran
APP_DEFAULT_LOCALE=fa-IR
DOCS_ENABLED=false
LOG_LEVEL=info
LOG_BODIES=false
TLS_TERMINATED_AT_EDGE=true
TRUST_PROXY=true
APP_ROLE=api

# --- Security (generate with: bash scripts/gen-secrets.sh) --------------------
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MINIMUM_RANDOM
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=7d
OTP_PEPPER=CHANGE_ME_32_BYTE_BASE64
REFRESH_PEPPER=CHANGE_ME_32_BYTE_BASE64
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
APP_ENCRYPTION_KEY_VERSION=1
CORS_ORIGINS=https://erp.carexy.shop
COOKIE_SECURE=true
SECURITY_HSTS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MIN=300
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15

# --- Database (values from the Chabakan PostgreSQL dashboard) ----------------
# Managed PostgreSQL gives ONE owner user; DB_MANAGED relaxes the
# two-role boot guard, MANAGED_PG strips cluster-role DDL from the migration.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
MIGRATION_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DB_MANAGED=true
MANAGED_PG=1
DB_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MIGRATION_ROLE=saman_migrator
DB_SCHEMA=erp

# --- Redis (Chabakan Redis service) -----------------------------------------
REDIS_URL=redis://:PASSWORD@HOST:PORT/0
REDIS_PREFIX=saman:
REDIS_TLS=false

# --- Object storage (S3-compatible) ------------------------------------------
# If the managed Minio app is unavailable: either run MinIO yourself as a Docker
# service (deploy/chabakan/minio.Dockerfile) or use ArvanCloud/Liara S3.
# The API boots without S3; uploads/exports fail until this is correct.
S3_ENDPOINT=https://MINIO_HOST
S3_REGION=us-east-1
S3_BUCKET=saman-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- Limo SMS (required in production) --------------------------------------
SMS_MODE=limo
LIMO_BASE_URL=https://api.limosms.com
LIMO_API_KEY=CHANGE_ME
LIMO_SENDER=CHANGE_ME
LIMO_OTP_PATTERN_ID=CHANGE_ME

# --- Channels / integrations ------------------------------------------------
CAREXY_API_BASE_URL=https://carexy.shop
CAREXY_API_KEY=CHANGE_ME
CAREXY_WEBHOOK_SECRET=CHANGE_ME
DIGIKALA_API_BASE_URL=https://seller.digikala.com/open-api/v1
DIGIKALA_CLIENT_ID=CHANGE_ME
DIGIKALA_CLIENT_SECRET=CHANGE_ME
DIGIKALA_WEBHOOK_SECRET=CHANGE_ME
