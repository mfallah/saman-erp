# =============================================================================
# Saman ERP — Chabakan / Docker service: WORKER role
# Same image/repository as the API service; no public port is needed.
# Copy into: سرویس worker ← تنظیمات ← متغیرهای محیطی
# =============================================================================

APP_ENV=production
NODE_ENV=production
APP_NAME=Saman ERP
APP_URL=https://erp.carexy.shop
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info
LOG_BODIES=false
APP_ROLE=worker

# Secrets must match the API service exactly (same JWT/encryption keys).
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MINIMUM_RANDOM
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=7d
OTP_PEPPER=CHANGE_ME_32_BYTE_BASE64
REFRESH_PEPPER=CHANGE_ME_32_BYTE_BASE64
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
APP_ENCRYPTION_KEY_VERSION=1
CORS_ORIGINS=https://erp.carexy.shop

DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
MIGRATION_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DB_MANAGED=true
MANAGED_PG=1
DB_SSL=false
DB_POOL_MAX=5
DB_SCHEMA=erp

REDIS_URL=redis://:PASSWORD@HOST:PORT/0
REDIS_PREFIX=saman:
REDIS_TLS=false

S3_ENDPOINT=https://MINIO_HOST
S3_REGION=us-east-1
S3_BUCKET=saman-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

SMS_MODE=limo
LIMO_BASE_URL=https://api.limosms.com
LIMO_API_KEY=CHANGE_ME
LIMO_SENDER=CHANGE_ME
LIMO_OTP_PATTERN_ID=CHANGE_ME
