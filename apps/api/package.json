{
  "name": "@saman/api",
  "version": "0.1.0",
  "private": true,
  "description": "Saman ERP API — NestJS 11 + Fastify platform foundation",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node dist-test/test/run.js",
    "test:vitest": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@saman/shared": "workspace:*",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "@saman/db": "workspace:*",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
