# =============================================================================
# Saman ERP — environment template
# Copy to `.env` (chmod 600) and fill values. NEVER commit `.env`.
# All values are validated at boot by apps/api/src/config/env.schema.ts
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production                 # development | test | staging | production
APP_NAME=Saman ERP
APP_PORT=4000
APP_URL=https://erp.carexy.shop    # public origin, no trailing slash
API_PREFIX=api
API_VERSION=v1
APP_TIMEZONE=Asia/Tehran
APP_DEFAULT_LOCALE=fa-IR
DOCS_ENABLED=false                 # OpenAPI UI at /api/v1/docs (off in prod)
LOG_LEVEL=info                     # trace|debug|info|warn|error|fatal
LOG_BODIES=false                   # must stay false in production
TLS_TERMINATED_AT_EDGE=true
TRUST_PROXY_CIDRS=                 # e.g. 172.16.0.0/12 for docker networks
FEATURE_STRICT_LOGIN_MODE=false    # incident switch: disable OTP fallbacks
BREAK_GLASS_USER=                  # sealed superadmin public id (offline account)
FEATURE_BREAK_GLASS=false
FEATURE_INVENTORY_FREEZE=false     # incident switch: block stock writes
FEATURE_ACCOUNTING_FREEZE=false    # incident switch: block journal posting
CAPTCHA_PROVIDER=                  # turnstile|hcaptcha|none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Security ----------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MINIMUM_RANDOM
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL=7d
OTP_PEPPER=CHANGE_ME_32_BYTE_BASE64
REFRESH_PEPPER=CHANGE_ME_32_BYTE_BASE64
# 32 bytes base64 (AES-256-GCM). Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
APP_ENCRYPTION_KEY_VERSION=1
# Comma separated, exact origins (scheme+host+port)
CORS_ORIGINS=https://erp.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=                     # empty = host-only cookie
TRUST_PROXY=true                   # true behind nginx/caddy
SECURITY_HSTS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MIN=300
LOGIN_MAX_FAILED=10
LOGIN_LOCK_MINUTES=15

# --- Database ----------------------------------------------------------------
# Runtime role: saman_app (NO DDL). Container default (service name "postgres"):
DATABASE_URL=postgres://saman_app:CHANGE_ME@postgres:5432/saman
# External / managed PostgreSQL example:
# DATABASE_URL=postgres://saman_app:CHANGE_ME@db.internal:5432/saman?sslmode=require
# DDL role: saman_migrator — used ONLY by pnpm db:migrate / db:seed
MIGRATION_DATABASE_URL=postgres://saman_migrator:CHANGE_ME@postgres:5432/saman
DB_SSL=false
DB_SSL_CA_PATH=                   # e.g. /run/secrets/db-ca.pem for external TLS
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MIGRATION_ROLE=saman_migrator
DB_SCHEMA=erp

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                    # set for non-local/redis-auth deployments
REDIS_PREFIX=saman:
REDIS_TLS=false

# --- Object storage (S3 / MinIO) --------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=saman-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=                # optional CDN/public base for media
UPLOAD_MAX_MB=20

# --- SMS (Limo SMS) ----------------------------------------------------------
# mock: log to console (dev only) | limo: real provider
SMS_MODE=mock
LIMO_BASE_URL=https://api.limosms.com
LIMO_API_KEY=
LIMO_SENDER=
LIMO_OTP_PATTERN_ID=
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
SMS_DAILY_BUDGET=2000              # max paid SMS/voice sends per org per day

# --- Channels ----------------------------------------------------------------
CAREXY_API_BASE_URL=https://carexy.shop
CAREXY_API_KEY=
CAREXY_WEBHOOK_SECRET=
DIGIKALA_API_BASE_URL=https://seller.digikala.com/open-api/v1
DIGIKALA_CLIENT_ID=
DIGIKALA_CLIENT_SECRET=
DIGIKALA_WEBHOOK_SECRET=
CHANNEL_SYNC_ENABLED=true
CHANNEL_STOCK_DEBOUNCE_MS=3000
CHANNEL_HTTP_TIMEOUT_MS=15000

# --- Jobs / worker -----------------------------------------------------------
WORKER_CONCURRENCY=10
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Backups (used by backup sidecar / scripts) ------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAYS=30
BACKUP_S3_PREFIX=backups/postgres
BACKUP_ENCRYPTION_PASSPHRASE=
# Optional offsite mirror (independent provider / region)
BACKUP_MIRROR_S3_ENDPOINT=
BACKUP_MIRROR_S3_BUCKET=
BACKUP_MIRROR_S3_ACCESS_KEY=
BACKUP_MIRROR_S3_SECRET_KEY=

# --- Bootstrap (first run only; see docs/06-deployment/INSTALL-FA.md) -------
BOOTSTRAP_ADMIN_MOBILE=09120000000
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
BOOTSTRAP_ORG_NAME=کرکسی شاپ

# --- Docker Compose image/ports ---------------------------------------------
POSTGRES_USER=saman
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=saman
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=saman
MINIO_ROOT_PASSWORD=CHANGE_ME
API_HOST_PORT=4000
WEB_HOST_PORT=8080
WEB_BIND_ADDR=127.0.0.1             # 0.0.0.0 only behind a host reverse proxy
DOMAIN=erp.carexy.shop
ACME_EMAIL=admin@carexy.shop
IMAGE_TAG=1.0.0
